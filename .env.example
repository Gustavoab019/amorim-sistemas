# ─────────────────────────────────────────────────────────────────────────────
# Ligação ao TrustVerify
#
# A Complexidade Simples não tem CRM próprio: a captação de leads, a gestão,
# o pagamento e a avaliação correm sobre o TrustVerify, como para qualquer
# outro negócio da rede. Estas variáveis são o que liga os dois.
#
# Todas são NEXT_PUBLIC_ de propósito — nenhuma é segredo. O que está aqui é
# exactamente o que qualquer visitante consegue ver no HTML, e é assim que
# tem de ser: a prova é pública ou não é prova.
# ─────────────────────────────────────────────────────────────────────────────

# Domínio do TrustVerify. Só mudar para apontar a staging.
NEXT_PUBLIC_TRUSTVERIFY_URL=https://www.trustverify.pt

# Domínio público canónico da matriz.
NEXT_PUBLIC_SITE_URL=https://complexidadesimples.com

# Número do bot (instância Z-API do TrustVerify).
# NÃO é o número pessoal. Se aqui estiver um número que não seja o bot, as
# mensagens do diagnóstico nunca chegam ao FSM: nada responde e o lead
# desaparece em silêncio.
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=351920027481

# _id da Company no TrustVerify (24 hex).
# Sai do output de: npx tsx scripts/register-complexidade-simples.ts --apply
# (no repo do TrustVerify).
#
# Enquanto estiver vazia o site funciona à mesma — o WhatsApp abre e a pessoa
# fala contigo — mas a mensagem vai sem a tag `#empresa_`, por isso o bot não
# sabe de quem se trata e o lead não fica registado no painel.
NEXT_PUBLIC_TRUSTVERIFY_COMPANY_ID=

# Slug do perfil público: trustverify.pt/empresas/<slug>
NEXT_PUBLIC_TRUSTVERIFY_COMPANY_SLUG=complexidade-simples
